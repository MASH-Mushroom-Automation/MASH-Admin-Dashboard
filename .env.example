# Backend API Configuration
# Copy this file to .env.local and fill in the values
# DO NOT commit .env or .env.local to git - they contain sensitive information

# Backend API URL (Railway Production)
NEXT_PUBLIC_API_URL=https://mash-backend-api-production.up.railway.app

# Vercel Deployment Configuration (Optional - only needed for CI/CD)
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id
